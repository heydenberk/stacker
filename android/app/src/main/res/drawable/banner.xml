<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180dp TV home-row banner: a dark field with a stack of three offset "record sleeves". -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="320dp"
                android:height="180dp" />
            <solid android:color="#FF14161A" />
        </shape>
    </item>
    <item
        android:bottom="56dp"
        android:left="128dp"
        android:right="80dp"
        android:top="24dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FF3A3F4B" />
        </shape>
    </item>
    <item
        android:bottom="40dp"
        android:left="104dp"
        android:right="104dp"
        android:top="40dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FF6B7385" />
        </shape>
    </item>
    <item
        android:bottom="24dp"
        android:left="80dp"
        android:right="128dp"
        android:top="56dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FFE8B04B" />
        </shape>
    </item>
</layer-list>
